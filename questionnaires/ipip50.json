  "source": "International Personality Item Pool, 50-item Big-Five Factor Markers: ten-item scales and reverse keys from https://ipip.ori.org/newBigFive5broadKey.htm. Factor markers refer to Goldberg (1992), The development of markers for the Big-Five factor structure, Psychological Assessment, 4, 26–42.",
  "source_url": "https://ipip.ori.org/newBigFive5broadKey.htm",
  "license": "Public domain. IPIP permits commercial and non-commercial use, copying, editing and translation without permission or fees.",
  "permission_url": "https://ipip.ori.org/newPermission.htm",
  "limitations": "The five domains overlap with BFI but are not interchangeable. Emotional Stability runs in the opposite conceptual direction from BFI Neuroticism; Intellect/Imagination is not an identical measure of BFI Openness. The self-description instruction is adapted for independent LLM prompts, omitting human demographic comparisons and confidentiality claims.",
  "scoring": {"version": "likert-aggregate-v1", "aggregation": "sum"},
  "instruction": "Indicate how accurately the following statement describes you as you generally are now. Respond as yourself, not as a fictional character. Each statement completes: I...",
  "options": [
    {"value": 1, "label": "Very inaccurate"},
    {"value": 2, "label": "Moderately inaccurate"},
    {"value": 3, "label": "Neither inaccurate nor accurate"},
    {"value": 4, "label": "Moderately accurate"},
    {"value": 5, "label": "Very accurate"}
  ],
  "items": [
    {"id": "ipip01", "trait": "Extraversion", "text": "Am the life of the party."},
    {"id": "ipip02", "trait": "Agreeableness", "text": "Feel little concern for others.", "reverse": true},
    {"id": "ipip03", "trait": "Conscientiousness", "text": "Am always prepared."},
    {"id": "ipip04", "trait": "Emotional Stability", "text": "Get stressed out easily.", "reverse": true},
    {"id": "ipip05", "trait": "Intellect/Imagination", "text": "Have a rich vocabulary."},
    {"id": "ipip06", "trait": "Extraversion", "text": "Don't talk a lot.", "reverse": true},
    {"id": "ipip07", "trait": "Agreeableness", "text": "Am interested in people."},
    {"id": "ipip08", "trait": "Conscientiousness", "text": "Leave my belongings around.", "reverse": true},
    {"id": "ipip09", "trait": "Emotional Stability", "text": "Am relaxed most of the time."},
    {"id": "ipip10", "trait": "Intellect/Imagination", "text": "Have difficulty understanding abstract ideas.", "reverse": true},
    {"id": "ipip11", "trait": "Extraversion", "text": "Feel comfortable around people."},
    {"id": "ipip12", "trait": "Agreeableness", "text": "Insult people.", "reverse": true},
    {"id": "ipip13", "trait": "Conscientiousness", "text": "Pay attention to details."},
    {"id": "ipip14", "trait": "Emotional Stability", "text": "Worry about things.", "reverse": true},
    {"id": "ipip15", "trait": "Intellect/Imagination", "text": "Have a vivid imagination."},
    {"id": "ipip16", "trait": "Extraversion", "text": "Keep in the background.", "reverse": true},
    {"id": "ipip17", "trait": "Agreeableness", "text": "Sympathize with others' feelings."},
    {"id": "ipip18", "trait": "Conscientiousness", "text": "Make a mess of things.", "reverse": true},
    {"id": "ipip19", "trait": "Emotional Stability", "text": "Seldom feel blue."},
    {"id": "ipip20", "trait": "Intellect/Imagination", "text": "Am not interested in abstract ideas.", "reverse": true},
    {"id": "ipip21", "trait": "Extraversion", "text": "Start conversations."},
    {"id": "ipip22", "trait": "Agreeableness", "text": "Am not interested in other people's problems.", "reverse": true},
    {"id": "ipip23", "trait": "Conscientiousness", "text": "Get chores done right away."},
    {"id": "ipip24", "trait": "Emotional Stability", "text": "Am easily disturbed.", "reverse": true},
    {"id": "ipip25", "trait": "Intellect/Imagination", "text": "Have excellent ideas."},
    {"id": "ipip26", "trait": "Extraversion", "text": "Have little to say.", "reverse": true},
    {"id": "ipip27", "trait": "Agreeableness", "text": "Have a soft heart."},
    {"id": "ipip28", "trait": "Conscientiousness", "text": "Often forget to put things back in their proper place.", "reverse": true},
    {"id": "ipip29", "trait": "Emotional Stability", "text": "Get upset easily.", "reverse": true},
    {"id": "ipip30", "trait": "Intellect/Imagination", "text": "Do not have a good imagination.", "reverse": true},
    {"id": "ipip31", "trait": "Extraversion", "text": "Talk to a lot of different people at parties."},
    {"id": "ipip32", "trait": "Agreeableness", "text": "Am not really interested in others.", "reverse": true},
    {"id": "ipip33", "trait": "Conscientiousness", "text": "Like order."},
    {"id": "ipip34", "trait": "Emotional Stability", "text": "Change my mood a lot.", "reverse": true},
    {"id": "ipip35", "trait": "Intellect/Imagination", "text": "Am quick to understand things."},
    {"id": "ipip36", "trait": "Extraversion", "text": "Don't like to draw attention to myself.", "reverse": true},
    {"id": "ipip37", "trait": "Agreeableness", "text": "Take time out for others."},
    {"id": "ipip38", "trait": "Conscientiousness", "text": "Shirk my duties.", "reverse": true},
    {"id": "ipip39", "trait": "Emotional Stability", "text": "Have frequent mood swings.", "reverse": true},
    {"id": "ipip40", "trait": "Intellect/Imagination", "text": "Use difficult words."},
    {"id": "ipip41", "trait": "Extraversion", "text": "Don't mind being the center of attention."},
    {"id": "ipip42", "trait": "Agreeableness", "text": "Feel others' emotions."},
    {"id": "ipip43", "trait": "Conscientiousness", "text": "Follow a schedule."},
    {"id": "ipip44", "trait": "Emotional Stability", "text": "Get irritated easily.", "reverse": true},
    {"id": "ipip45", "trait": "Intellect/Imagination", "text": "Spend time reflecting on things."},
    {"id": "ipip46", "trait": "Extraversion", "text": "Am quiet around strangers.", "reverse": true},
    {"id": "ipip47", "trait": "Agreeableness", "text": "Make people feel at ease."},
    {"id": "ipip48", "trait": "Conscientiousness", "text": "Am exacting in my work."},
    {"id": "ipip49", "trait": "Emotional Stability", "text": "Often feel blue.", "reverse": true},
    {"id": "ipip50", "trait": "Intellect/Imagination", "text": "Am full of ideas."}
  ]
}
